# Mainnet RPC for the fork's datasource and the Kamino relay (a free Helius or QuickNode endpoint works); empty uses the public endpoint
SURFPOOL_DATASOURCE_RPC_URL=
# Optional; keyless Jupiter access is limited to 0.5 requests per second
JUPITER_API_KEY=
# Pyth Pro access token: the USDT/USD update of USDT sweeps (the devnet smoke and the fork suite)
PYTH_PRO_ACCESS_TOKEN=
